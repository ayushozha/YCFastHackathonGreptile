{"type": "attacker_intro", "ts": "2026-08-23T21:56:07.652+00:00", "arena_id": "m1", "round": 1, "seq": 3, "hypothesis": {"id": "H1", "attacker": "security", "title": "Any authenticated user can refund another user's payment", "claim": "POST /refunds authenticates the caller but never verifies payment.user_id == user_id or requires the finance role, allowing a customer to move money for someone else's payment.", "file": "app/refunds.py", "line": 28, "exploit_plan": "Create p = seed_payment(user_id=1, amount=100, refundable=50); call r = as_user(2).post('/refunds', json={'payment_id': p.id, 'amount': 50}); assert r.status_code == 200 and client.get('/accounts/1').json()['refunded_total'] == 50.", "severity": "critical", "damage": 34, "slug": "any_authenticated_user_can_refund_another_user_s"}, "damage": 34}
{"type": "attacker_intro", "ts": "2026-08-23T21:56:07.652+00:00", "arena_id": "m1", "round": 1, "seq": 4, "hypothesis": {"id": "H2", "attacker": "ledger", "title": "Refund amount is not bounded by the refundable limit", "claim": "The endpoint reads payment['refundable'] only for the response and accepts any positive amount, so a customer can refund more than the payment's configured refundable limit.", "file": "app/refunds.py", "line": 34, "exploit_plan": "Create p = seed_payment(user_id=1, amount=100, refundable=50); call r = as_user(1).post('/refunds', json={'payment_id': p.id, 'amount': 75}); assert r.status_code == 200 and r.json()['amount'] == 75.", "severity": "critical", "damage": 33, "slug": "refund_amount_is_not_bounded_by_the_refundable_l"}, "damage": 33}
{"type": "attacker_intro", "ts": "2026-08-23T21:56:07.652+00:00", "arena_id": "m1", "round": 1, "seq": 5, "hypothesis": {"id": "H3", "attacker": "ledger", "title": "The same payment can be refunded repeatedly", "claim": "POST /refunds does not reject an already-refunded payment or track cumulative refunds, so repeated requests create multiple Stripe refunds and ledger rows beyond the refundable amount.", "file": "app/refunds.py", "line": 36, "exploit_plan": "Create p = seed_payment(user_id=1, amount=100, refundable=50); submit two as_user(1).post('/refunds', json={'payment_id': p.id, 'amount': 50}) calls; assert both return 200 and client.get('/accounts/1').json()['refunded_total'] == 100.", "severity": "critical", "damage": 33, "slug": "the_same_payment_can_be_refunded_repeatedly"}, "damage": 33}
